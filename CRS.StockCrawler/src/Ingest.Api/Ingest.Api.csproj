<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--  Arbeitsplatz- statt Server-Speicherbereinigung.

          ASP.NET waehlt von sich aus die Server-Variante: ein Heap je Kern,
          spaete Sammlung, dafuer hoher Durchsatz. Das passt fuer einen Dienst
          mit vielen gleichzeitigen Anfragen; diese Anwendung hat einen
          Benutzer und haelt Zwischenspeicher.

          Gemessen am 27.09.2026 nach dem Vorwaermen von 318.240 Kursbars
          (rund 38 MB echte Daten): 0,93 GB belegter Arbeitsspeicher, der auch
          nach dreissig Sekunden Ruhe nicht sank. Das ist weit ueberwiegend
          nicht gesammelter Muell aus dem Vorwaermlauf — der liest je Wert
          2.392 Prognosen, um neun zu behalten.

          Die Auflage lautet, nie mehr Arbeitsspeicher zu belegen als der
          abgeloeste SQL Server (gemessen 2,10 GB). Eingehalten waere sie auch
          vorher gewesen; aber "unter der Grenze" ist kein Grund, das
          Zwanzigfache der Nutzdaten zu halten.                              -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Cronos" Version="0.8.4" />
    <PackageReference Include="Dapper" Version="2.1.66" />
  </ItemGroup>

  <!--  Die Sprachdateien gehören in die Auslieferung.

        Ohne das findet Ablage.Sprachen im veröffentlichten Verzeichnis nichts,
        und die Oberfläche bleibt still deutsch — auf dem Entwicklungsrechner
        wäre davon nie etwas zu merken, weil dort der Entwicklungspfad greift.  -->
  <ItemGroup>
    <Content Include="../../infra/loc/loc.res.*.xml"
             Link="loc/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Ingest.Core/Ingest.Core.csproj" />
    <ProjectReference Include="../Ingest.Infrastructure/Ingest.Infrastructure.csproj" />
  </ItemGroup>

</Project>
