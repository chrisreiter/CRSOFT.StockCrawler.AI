{
  // Welche Datenbank laeuft, entscheidet dieser Block. Regel (DependencyInjection.
  // VerbindungAusKonfiguration): Ist "Datenbank:System" gesetzt, gilt es; sonst
  // Postgres, sobald "Postgres" nicht leer ist; sonst SQL Server. Zum Umschalten
  // also die eine Zeile auskommentieren und die andere freigeben. Der Konfigurations-
  // leser von .NET erlaubt //-Kommentare in dieser Datei.
  "ConnectionStrings": {
    "Sql": "Server=.\\SQLSERVER;Database=stockcrawler;User Id=stockcrawler;Password=StockCrawler!;TrustServerCertificate=true",
    // "Postgres": "Host=localhost;Port=55531;Database=stockcrawler;Username=cire;Password=cire05"
  },
  "Datenbank": {
    // "SqlServer" oder "Postgres"; leer = aus den Verbindungszeichenfolgen ableiten.
    "System": ""
  },
  "Sources": {
    "Yahoo": {
      "BaseUrl": "https://query1.finance.yahoo.com",
      "DelayMs": 350
    },
    "TwelveData": {
      "BaseUrl": "https://api.twelvedata.com",
      "ApiKey": "__TWELVEDATA_API_KEY__",
      "DelayMs": 8000,
      "MaxOutputSize": 5000
    },
    "CoinGecko": {
      "BaseUrl": "https://api.coingecko.com/api/v3",
      "ApiKey": "__COINGECKO_API_KEY__",
      "VsCurrency": "usd",
      "DelayMs": 2500
    }
  },
  // Betrieb dieser Instanz. "master": rechnet und schreibt (Zeitplan, Laeufe,
  // Modelle). "slave": laeuft auf einer replizierten Datenbank, nur lesend fuer
  // jeden, kein Zeitplan, keine Modellaufrufe -- fuer den Live-Server ohne GPU.
  // GastZugang: Anmeldung als Gast ohne Kennwort, nur lesend, mit dauerhaftem
  // Hinweis. Auf dem Slave per Umgebungsvariable: Betrieb__Rolle=slave,
  // Betrieb__GastZugang=true.
  "Betrieb": {
    "Rolle": "master",
    "GastZugang": true
  },
  // Der Hausmeister: loescht taeglich, was keine Ansicht und keine Messung mehr
  // liest. Jede Frist in Tagen; 0 schaltet die Regel ab. Begruendung je Regel in
  // docs/HAUSMEISTER.md und in der Oberflaeche unter System.
  "Housekeeping": {
    "Aktiv": true,
    "ImTageslaufLoeschen": true,
    "BudgetMinuten": 20,
    "Blockgroesse": 25000,

    "KurvenLaeufeTage": 14,
    "PrognoseKomponentenTage": 30,
    "UnbewertbareTage": 30,
    "BewertetePrognosenTage": 365,
    "RueckrechnungTage": 1825,
    "KreuzungenTage": 730,
    "NachrichtenTage": 365,
    "LaufprotokollTage": 90,
    "ReasoningProtokollTage": 90,
    "AutopilotProtokollTage": 365,
    "EigenesProtokollTage": 365
  },
  "Ingest": {
    "HistoryMonths": 300,
    "HourlyHistoryMonths": 12,
    "TopStocks": 100,
    "TopEtfs": 100,
    "TopCrypto": 100,
    "DailyCronUtc": "20 2 * * *",
    "HourlyCronUtc": "8 * * * *",

    // Lief die Anwendung zum faelligen Termin nicht, wird er beim naechsten
    // Start einmal nachgeholt -- sonst stehen die Tagesbars nach einem Ausfall
    // still, bis der Termin am folgenden Morgen wiederkehrt.
    "NachholenNachAusfall": true,
    "NachholVerzoegerungSekunden": 30,

    "Horizons": [ 24, 168, 336, 720, 2160, 4380, 8760 ],
    "AutoStartBackfill": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}