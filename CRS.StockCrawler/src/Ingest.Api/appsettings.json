{
  // Welche Datenbank laeuft, entscheidet dieser Block. Regel (DependencyInjection.
  // VerbindungAusKonfiguration): Ist "Datenbank:System" gesetzt, gilt es; sonst
  // Postgres, sobald "Postgres" nicht leer ist; sonst SQL Server. Zum Umschalten
  // also die eine Zeile auskommentieren und die andere freigeben. Der Konfigurations-
  // leser von .NET erlaubt //-Kommentare in dieser Datei.
  "ConnectionStrings": {
    "Sql": "Server=.\\SQLSERVER;Database=stockcrawler;User Id=stockcrawler;Password=StockCrawler!;TrustServerCertificate=true",
    // "Postgres": "Host=localhost;Port=5432;Database=stockcrawler;Username=stockcrawler;Password=StockCrawler!"
  },
  "Datenbank": {
    // "SqlServer" oder "Postgres"; leer = aus den Verbindungszeichenfolgen ableiten.
    "System": ""
  },
  "Sources": {
    "Yahoo": {
      "BaseUrl": "https://query1.finance.yahoo.com",
      "DelayMs": 350
    },
    "TwelveData": {
      "BaseUrl": "https://api.twelvedata.com",
      "ApiKey": "__TWELVEDATA_API_KEY__",
      "DelayMs": 8000,
      "MaxOutputSize": 5000
    },
    "CoinGecko": {
      "BaseUrl": "https://api.coingecko.com/api/v3",
      "ApiKey": "__COINGECKO_API_KEY__",
      "VsCurrency": "usd",
      "DelayMs": 2500
    }
  },
  // Betrieb dieser Instanz. "master": rechnet und schreibt (Zeitplan, Laeufe,
  // Modelle). "slave": laeuft auf einer replizierten Datenbank, nur lesend fuer
  // jeden, kein Zeitplan, keine Modellaufrufe -- fuer den Live-Server ohne GPU.
  // GastZugang: Anmeldung als Gast ohne Kennwort, nur lesend, mit dauerhaftem
  // Hinweis. Auf dem Slave per Umgebungsvariable: Betrieb__Rolle=slave,
  // Betrieb__GastZugang=true.
  "Betrieb": {
    "Rolle": "master",
    "GastZugang": true
  },
  "Ingest": {
    "HistoryMonths": 300,
    "HourlyHistoryMonths": 12,
    "TopStocks": 100,
    "TopEtfs": 100,
    "TopCrypto": 100,
    "DailyCronUtc": "20 2 * * *",
    "HourlyCronUtc": "8 * * * *",
    "Horizons": [ 24, 168, 336, 720, 2160, 4380, 8760 ],
    "AutoStartBackfill": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}